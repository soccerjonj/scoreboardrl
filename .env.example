# ── ScoreboardRL environment variables ───────────────────────────────────────
# Copy to .env (or set in your host's dashboard) and fill in real values.
# All client-exposed vars must be prefixed VITE_. Never put server secrets here
# (Stripe secret key, Gemini key, service-role key live only in Supabase Edge
# Function env, not in the client build).

# Supabase project — required
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY

# Stripe price IDs — only needed when billing is enabled (see VITE_BILLING_ENABLED)
VITE_STRIPE_PRICE_PRO_MONTHLY=
VITE_STRIPE_PRICE_LIFETIME=

# Feature flags
# Leave unset/false for a free-only launch (hides all paid-tier UI).
# Set to "true" once Stripe billing is live.
VITE_BILLING_ENABLED=false

# Error monitoring — optional. When set, Sentry captures runtime errors.
VITE_SENTRY_DSN=
